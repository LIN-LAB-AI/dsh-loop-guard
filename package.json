{
  "name": "dsh-loop-guard",
  "description": "Loop guard plugin for DeepSeek Harness: counts repeated tool calls cumulatively across a turn, enforces (block the call, or stop the turn), and can retry a stopped turn with a bounded, narrowed instruction",
  "version": "0.4.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/loop-guard.test.js",
    "test:e2e": "node --test test/e2e.test.js",
    "test:all": "node --test test/loop-guard.test.js test/e2e.test.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent",
    "loop-detection",
    "guard"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-loop": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2"
  },
  "engines": {
    "node": ">=20"
  }
}
